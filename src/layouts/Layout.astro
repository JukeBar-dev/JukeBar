---
import "../styles/global.css";
import BackToTop from "../components/BackToTop.astro";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Données structurées propres à la page (ex. fil d'Ariane), ajoutées à celles du bar. */
  structuredData?: Record<string, unknown>[];
  /** Exclut la page des moteurs de recherche (ex. page 404). */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = "/og-image.png",
  ogImageAlt = "Le JukeBar, bar à Orléans",
  structuredData = [],
  noindex = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = new URL("/", Astro.site).toString();

const barSchema = {
  "@context": "https://schema.org",
  "@type": "BarOrPub",
  "@id": `${siteURL}#bar`,
  name: "Le JukeBar",
  url: siteURL,
  image: new URL("/og-image.png", Astro.site).toString(),
  logo: new URL("/logo.png", Astro.site).toString(),
  address: {
    "@type": "PostalAddress",
    streetAddress: "258 rue de Bourgogne",
    postalCode: "45000",
    addressLocality: "Orléans",
    addressCountry: "FR",
  },
  sameAs: ["https://www.instagram.com/lejukebar/"],
};

const schemas = [barSchema, ...structuredData];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}

    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0912" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=League+Spartan:wght@700;800;900&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Le JukeBar" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <slot />
    <BackToTop />
    <Analytics />
  </body>
</html>
